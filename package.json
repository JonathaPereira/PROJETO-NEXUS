{
  "name": "projeto-nexus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nexus: Ecos do Crepúsculo — protótipo original de combate tático 3 contra 3",
  "scripts": {
    "dev": "node --watch server.mjs",
    "start": "node server.mjs",
    "build:offline": "node scripts/build-offline.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node --test tests/browser.mjs",
    "test:offline": "npm run build:offline && node --test tests/offline.mjs",
    "check": "node --check src/app.js && node --check src/engine.js && node --check src/art.js"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "esbuild": "0.27.0"
  }
}
